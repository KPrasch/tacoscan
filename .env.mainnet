# Mainnet Configuration
# Network identifier
VITE_NETWORK=mainnet

# Network Switcher URLs
VITE_MAINNET_URL=https://tacoscan.io
VITE_LYNX_URL=https://lynx.tacoscan.io
VITE_TAPIR_URL=https://tapir.tacoscan.io

# RPC Endpoints (keeping existing var names for compatibility)
VITE_RPC_ETH_MAINNET=https://ethereum-rpc.publicnode.com
VITE_RPC_ETH_POLYGON=https://polygon-bor-rpc.publicnode.com

# Subgraph API (Goldsky)
VITE_SUBGRAPH_ETHEREUM=https://api.goldsky.com/api/public/project_cmgzo6cgq00lc5np2dwaycfdl/subgraphs/taco-mainnet-ethereum/v2.1.7/gn
VITE_SUBGRAPH_POLYGON=https://api.goldsky.com/api/public/project_cmgzo6cgq00lc5np2dwaycfdl/subgraphs/taco-mainnet-polygon/2.1.13/gn
VITE_SUBGRAPH_BASE=https://api.goldsky.com/api/public/project_cmgzo6cgq00lc5np2dwaycfdl/subgraphs/taco-mainnet-base/2.1.8/gn

# Etherscan API (keeping existing var name for compatibility)
VITE_MAINNET_AP_BALANCE=your_etherscan_api_key_here

# WalletConnect Configuration
VITE_REACT_APP_WALLET_CONNECT_PROJECT_ID=788753258a7a69b551cff57742637490

# Production settings
VITE_SUPPRESS_WARNINGS=true

# Optional: Enhanced RPC providers
# VITE_ALCHEMY_API_KEY=your_alchemy_key_here
# VITE_INFURA_API_KEY=your_infura_key_here