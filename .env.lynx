# Lynx Testnet Configuration
# Network identifier
VITE_NETWORK=lynx

# Network Switcher URLs
VITE_MAINNET_URL=https://tacoscan.io
VITE_LYNX_URL=https://lynx.tacoscan.io
VITE_TAPIR_URL=https://tapir.tacoscan.io

# RPC Endpoints (using same var names as mainnet for compatibility)
VITE_RPC_ETH_MAINNET=https://sepolia.infura.io/v3/0b802427db2e42e18e8eadd1ec01f934
VITE_RPC_ETH_POLYGON=https://polygon-amoy.infura.io/v3/0b802427db2e42e18e8eadd1ec01f934

# Subgraph API (Goldsky)
VITE_SUBGRAPH_ETHEREUM=https://api.goldsky.com/api/public/project_cmgzo6cgq00lc5np2dwaycfdl/subgraphs/taco-lynx-ethereum/v2.1.5/gn
VITE_SUBGRAPH_POLYGON=https://api.goldsky.com/api/public/project_cmgzo6cgq00lc5np2dwaycfdl/subgraphs/taco-lynx-polygon/2.1.12/gn
VITE_SUBGRAPH_BASE=https://api.goldsky.com/api/public/project_cmgzo6cgq00lc5np2dwaycfdl/subgraphs/taco-lynx-base/2.1.6/gn

# Etherscan API (using same var name as mainnet for compatibility)
VITE_MAINNET_AP_BALANCE=your_polygonscan_api_key_here

# WalletConnect Configuration
VITE_REACT_APP_WALLET_CONNECT_PROJECT_ID=788753258a7a69b551cff57742637490

# Chain Configuration
VITE_CHAIN_ID=80002
VITE_CHAIN_NAME=Polygon Amoy (Lynx)

# Contract Addresses Override (if different from artifacts)
# VITE_TACO_APPLICATION_ADDRESS=0x...
# VITE_COORDINATOR_ADDRESS=0x...

# Optional: Enhanced RPC providers
# VITE_ALCHEMY_API_KEY=your_alchemy_key_here
# VITE_INFURA_API_KEY=your_infura_key_here
